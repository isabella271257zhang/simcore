# Doxygen configuration for the simcore public API.
#
# The CMake `doc` target runs Doxygen from the repository root and supplies
# SIMCORE_DOC_OUTPUT_DIR so generated files land in the build tree.
# Manual usage from the repository root:
#   SIMCORE_DOC_OUTPUT_DIR=build/docs doxygen docs/Doxyfile

PROJECT_NAME           = "simcore"
PROJECT_BRIEF          = "Reusable discrete-time simulation core library"
PROJECT_NUMBER         = 0.1.0

OUTPUT_DIRECTORY       = $(SIMCORE_DOC_OUTPUT_DIR)
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = include
FILE_PATTERNS          = *.h
RECURSIVE              = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
QUIET                  = NO

INPUT_ENCODING         = UTF-8
MARKDOWN_SUPPORT       = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_TREEVIEW      = YES

HAVE_DOT               = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

SORT_MEMBER_DOCS       = YES
ALPHABETICAL_INDEX     = YES
